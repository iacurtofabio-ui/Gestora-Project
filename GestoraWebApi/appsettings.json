{

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "Secret": "",
    "Issuer": "GestoraWebApi",
    "Audience": "GestoraClient",
    "ExpiryMinutes": 60
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "// Nota": "In produzione si scrive solo su console: il filesystem del container e' effimero e la piattaforma di hosting raccoglie lo stdout. Il sink su file e' attivo solo in Development.",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedOrigins": [ "http://localhost:5173" ]
}


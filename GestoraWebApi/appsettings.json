{

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "Secret": "",
    "Issuer": "GestoraWebApi",
    "Audience": "GestoraClient",
    "ExpiryMinutes": 60,
    "MaxSessionHours": 12
  },

  "Prenotazioni": {
    "MaxCopertiPerPrenotazione": 50,
    "MaxCopertiPrenotazioneOnline": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "// Nota": "In produzione si scrive solo su console: il filesystem del container e' effimero e la piattaforma di hosting raccoglie lo stdout. Il sink su file e' attivo solo in Development.",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedOrigins": [ "http://localhost:5173" ]
}

